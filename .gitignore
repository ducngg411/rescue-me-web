# Backup folders - DO NOT commit to Git (contains sensitive data)
backup_*/
backup/

# Environment files - never commit real secrets
.env
.env.local
.env.*.local
*.env.backend
*.env.frontend
# Production env files (filled from .example templates on server)
.env.production
backend/.env.production
frontend/.env.production

.claude

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
node_modules

# Docs
docs/

# Build outputs
dist/
build/
.next/

# Database
*.db
*.sqlite
postgres_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker / deployment
*.tar

# SSL certificates (generated on server)
nginx/certs/
certbot/certs/

# TypeScript build cache
tsconfig.tsbuildinfo
