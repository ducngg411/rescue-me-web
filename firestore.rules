rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /locations/{requestId} {
      allow read, write: if true;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if true;
    }
  }
}
