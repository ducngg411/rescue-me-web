generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String?
  avatar                String?
  authProvider          AuthProvider
  hashedPassword        String?
  googleId              String?            @unique
  profileCompleted      Boolean            @default(false)
  role                  UserRole           @default(USER)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lastLogin             DateTime?
  contactEmail          String?
  defaultAddress        Json?
  fullName              String?
  licensePlate          String?
  phoneNumber           String?
  vehicleColor          String?
  vehicleType           VehicleType?
  businessAddress       Json?
  businessName          String?
  isActive              Boolean            @default(false)
  serviceRadiusKm       Int?
  serviceTypes          ServiceType[]
  supportedVehicleTypes VehicleType[]
  verificationStatus    VerificationStatus @default(DRAFT)
  permanentAddress      Json?
  providerType          ProviderType?
  submittedAt           DateTime?
  rejectReasonCode      String?
  rejectReasonDetail    String?
  rejectedAt            DateTime?
  address               String?
  approvedAt            DateTime?
  baseFee               Int?
  emergencyAvailable    Boolean            @default(false)
  isOnline              Boolean            @default(false)
  pricePerKm            Int?
  serviceName           String?
  suspendedAt           DateTime?
  suspensionReason      String?
  bannedAt              DateTime?
  banReason             String?
  rescueVehicles        Json?
  currentLocation       Json?
  lastLocationUpdate    DateTime?
  averageRating         Float?
  reviewCount           Int                @default(0)
  providerWallet        ProviderWallet?    @relation("ProviderWallet")
  quotes                Quote[]            @relation("ProviderQuotes")
  assignedRequests      RescueRequest[]    @relation("AssignedRequests")
  rescueRequests        RescueRequest[]    @relation("UserRequests")
  reviewsReceived       Review[]           @relation("ProviderReviews")
  reviewsGiven          Review[]           @relation("UserReviews")
  sessions              Session[]
  uploads               Upload[]
  userWallet            UserWallet?        @relation("UserWallet")
  passwordResetTokens        PasswordResetToken[]
  disputesResolved           DisputeCase[]          @relation("DisputeResolvedBy")
  disputesAssigned           DisputeCase[]          @relation("DisputeAssignedTo")
  disputeMessages            DisputeMessage[]       @relation("DisputeMessageAuthor")
  disputeEvidenceUploaded    DisputeEvidence[]      @relation("DisputeEvidenceUploader")
  disputesOpened             DisputeCase[]          @relation("DisputeOpenedBy")
  disputeReadStates          DisputeReadState[]

  providerWithdrawalAccounts ProviderWithdrawalAccount[] @relation("ProviderWithdrawalAccounts")
  customerWithdrawalAccounts CustomerWithdrawalAccount[] @relation("CustomerWithdrawalAccounts")
  chatbotConversations       ChatbotConversation[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Upload {
  id                     String        @id @default(cuid())
  userId                 String
  purpose                UploadPurpose
  docType                DocumentType?
  objectKey              String        @unique
  fileName               String
  fileSize               Int
  contentType            String
  publicUrl              String
  confirmed              Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  cloudinaryPublicId     String?
  cloudinaryResourceType String?
  storageType            StorageType   @default(R2)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([objectKey])
  @@map("uploads")
}

model RescueRequest {
  id                   String         @id @default(cuid())
  /// Human-friendly id for support: RMO-YYMMDD-XXXX (same in user/provider/admin UIs)
  orderCode            String?        @unique
  userId               String?
  guestSessionId       String?
  requesterType        RequesterType  @default(USER)
  incidentType         IncidentType
  vehicleType          VehicleType
  /// Snapshot of requester vehicle at time of request (guests have no User row)
  licensePlate         String?
  vehicleColor         String?
  description          String?
  pickupLocation       Json
  dropoffLocation      Json?
  status               RequestStatus  @default(CREATED)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  contactPhone         String         @default("")
  videoUrls            String[]       @default([])
  searchPhase          Int            @default(1)
  assignedProviderId   String?
  matchingStartedAt    DateTime?
  assignedAt           DateTime?
  expiresAt            DateTime?
  matchAttempts        Int            @default(1)
  matchedDistance      Float?
  matchedEta           Int?
  declinedProviders    String[]       @default([])
  maxQuotes            Int            @default(3)
  quoteCount           Int            @default(0)
  quoteWindowClosedAt  DateTime?
  quoteWindowDuration  Int            @default(90)
  quoteWindowExpiresAt DateTime?
  viewingProviders     String[]       @default([])
  viewingUpdatedAt     DateTime?
  completedAt          DateTime?
  payment              Payment?
  quotes               Quote[]
  media                RequestMedia[]
  assignedProvider     User?          @relation("AssignedRequests", fields: [assignedProviderId], references: [id])
  user                 User?          @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  guestSession         GuestSession?  @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  review               Review?
  disputeCases         DisputeCase[]
  jobPaymentTransaction JobPaymentTransaction?

  @@index([userId])
  @@index([guestSessionId, status])
  @@index([status])
  @@index([createdAt])
  @@index([assignedProviderId])
  @@map("rescue_requests")
}

model RequestMedia {
  id                 String        @id @default(cuid())
  requestId          String
  objectKey          String?       @unique
  fileName           String
  fileSize           Int
  contentType        String
  publicUrl          String
  createdAt          DateTime      @default(now())
  cloudinaryPublicId String?
  mediaType          String        @default("IMAGE")
  request            RescueRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_media")
}

model Quote {
  id                      String        @id @default(cuid())
  rescueRequestId         String
  providerId              String
  price                   Int
  estimatedArrivalMinutes Int
  message                 String?
  status                  QuoteStatus   @default(PENDING)
  rejectionReason         String?
  userRespondedAt         DateTime?
  providerLocation        Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  expiresAt               DateTime?
  provider                User          @relation("ProviderQuotes", fields: [providerId], references: [id])
  rescueRequest           RescueRequest @relation(fields: [rescueRequestId], references: [id], onDelete: Cascade)

  @@unique([rescueRequestId, providerId])
  @@index([rescueRequestId])
  @@index([providerId])
  @@index([status])
  @@index([rescueRequestId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("quotes")
}

model Payment {
  id                  String        @id @default(cuid())
  requestId           String        @unique
  providerId          String
  userId              String?
  guestSessionId      String?
  baseFee             Int           @default(0)
  distanceFee         Int           @default(0)
  overtimeFee         Int           @default(0)
  otherFee            Int           @default(0)
  totalAmount         Int
  surchargeNote       String?
  note                String?
  photoUrls           String[]      @default([])
  paymentMethod       PaymentMethod @default(CASH)
  userConfirmedAt     DateTime?
  providerConfirmedAt DateTime?
  disputeReason       String?
  disputedAt          DateTime?
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  request             RescueRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  disputeCase         DisputeCase?

  @@index([requestId])
  @@index([providerId])
  @@index([userId])
  @@map("payments")
}

model DisputeCase {
  id                         String                    @id @default(cuid())
  paymentId                  String                    @unique
  requestId                  String
  openedByUserId             String?
  openedByRole               DisputeOpenedByRole
  /// Amount in dispute (VND). May be less than totalAmount for partial disputes.
  targetAmount               Int                       @default(0)
  reason                     String
  description                String?
  expectedOutcome            String?
  status                     DisputeCaseStatus         @default(WAITING_FOR_PROVIDER)
  resolutionType             DisputeResolutionType?
  resolutionAmountCustomer   Int?
  resolutionAmountProvider   Int?
  resolutionNote             String?
  firstResponseDueAt         DateTime?
  resolutionDueAt            DateTime?
  firstRespondedAt           DateTime?
  resolvedAt                 DateTime?
  resolvedByUserId           String?
  assignedToUserId           String?
  customerMessageCount       Int                       @default(0)
  providerMessageCount       Int                       @default(0)
  customerReplyAllowed       Boolean                   @default(false)
  providerReplyAllowed       Boolean                   @default(false)
  providerUnresponsiveAt     DateTime?
  lastCoordinatorNote        String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  payment                    Payment                   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  request                    RescueRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  openedBy                   User?                     @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  resolvedBy                 User?                     @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  assignedTo                 User?                     @relation("DisputeAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages                   DisputeMessage[]
  evidence                   DisputeEvidence[]
  readStates                 DisputeReadState[]

  @@index([requestId])
  @@index([status])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@index([createdAt])
  @@map("dispute_cases")
}

model DisputeMessage {
  id           String              @id @default(cuid())
  caseId       String
  senderRole   DisputeSenderRole
  messageType  DisputeMessageType  @default(TEXT)
  body         String
  mediaUrls    String[]            @default([])
  /// INTERNAL = admin-only notes; PUBLIC = visible in customer/provider-facing timeline
  visibility   DisputeVisibility   @default(PUBLIC)
  userId       String?
  createdAt    DateTime            @default(now())
  disputeCase  DisputeCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author       User?               @relation("DisputeMessageAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([createdAt])
  @@map("dispute_messages")
}

model DisputeReadState {
  id            String      @id @default(cuid())
  caseId         String
  userId         String
  lastReadAt     DateTime?
  lastMessageId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  disputeCase    DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId, updatedAt])
  @@map("dispute_read_states")
}

model DisputeEvidence {
  id                 String      @id @default(cuid())
  caseId             String
  url                String
  note               String?
  uploadedByUserId   String?
  createdAt          DateTime    @default(now())
  disputeCase        DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy         User?       @relation("DisputeEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("dispute_evidence")
}

model ProviderWallet {
  id                String              @id @default(cuid())
  providerId        String              @unique
  availableBalance  Int                 @default(0)
  pendingBalance    Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  topupCode         String?             @unique
  provider          User                @relation("ProviderWallet", fields: [providerId], references: [id], onDelete: Cascade)
  topupTransactions TopupTransaction[]
  transactions      WalletTransaction[]

  @@index([providerId])
  @@map("provider_wallets")
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  /// Public reconciliation code for this wallet line (provider)
  txnCode       String?                 @unique
  walletId      String
  type          WalletTransactionType
  amount        Int
  status        WalletTransactionStatus @default(PENDING)
  referenceType WalletReferenceType
  referenceId   String
  description   String?
  sepayId       Int?                    @unique
  sepayReferenceCode String?
  createdAt     DateTime                @default(now())
  holdReleaseAt DateTime?
  wallet        ProviderWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, status])
  @@index([walletId, type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model ProviderWithdrawalAccount {
  id                 String   @id @default(cuid())
  providerId        String
  provider          User     @relation("ProviderWithdrawalAccounts", fields: [providerId], references: [id], onDelete: Cascade)

  accountNumber      String
  bankCode           BankCode?
  bankName           String
  branchName         String?
  accountHolderName  String

  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([providerId])
  @@map("provider_withdrawal_accounts")
}

model CustomerWithdrawalAccount {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation("CustomerWithdrawalAccounts", fields: [userId], references: [id], onDelete: Cascade)

  accountNumber     String
  bankCode          BankCode?
  bankName          String
  branchName        String?
  accountHolderName String

  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("customer_withdrawal_accounts")
}

model TopupTransaction {
  id                 String         @id @default(cuid())
  /// Internal topup batch id (not the bank transfer content)
  txnCode            String?        @unique
  walletId           String
  amount             Int
  status             String         @default("PENDING")
  transferCode       String
  sepayId            Int?           @unique
  sepayReferenceCode String?
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  expireAt           DateTime?
  wallet             ProviderWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, status])
  @@index([transferCode])
  @@map("topup_transactions")
}

model JobPaymentTransaction {
  id           String          @id @default(cuid())
  /// Public reconciliation code for this job QR payment row
  txnCode      String?         @unique
  requestId    String          @unique
  paymentId    String          @unique
  transferCode String          @unique
  amount       Int
  status       String          @default("PENDING")
  expireAt     DateTime
  sepayId      Int?            @unique
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  request      RescueRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([transferCode])
  @@index([requestId, status])
  @@map("job_payment_transactions")
}

model Review {
  id              String        @id @default(cuid())
  rescueRequestId String        @unique
  userId          String
  providerId      String
  rating          Int
  comment         String?
  tags            String[]      @default([])
  createdAt       DateTime      @default(now())
  provider        User          @relation("ProviderReviews", fields: [providerId], references: [id])
  request         RescueRequest @relation(fields: [rescueRequestId], references: [id], onDelete: Cascade)
  user            User          @relation("UserReviews", fields: [userId], references: [id])

  @@index([providerId])
  @@index([userId])
  @@map("reviews")
}

model UserWallet {
  id               String                  @id @default(cuid())
  userId           String                  @unique
  availableBalance Int                     @default(0)
  pendingBalance   Int                     @default(0)
  topupCode        String?                 @unique
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  topupTxs         UserTopupTransaction[]
  transactions     UserWalletTransaction[]
  user             User                    @relation("UserWallet", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_wallets")
}

model UserWalletTransaction {
  id            String                  @id @default(cuid())
  /// Public reconciliation code for this wallet line (user)
  txnCode       String?                 @unique
  walletId      String
  type          WalletTransactionType
  amount        Int
  status        WalletTransactionStatus @default(PENDING)
  referenceType UserWalletReferenceType
  referenceId   String
  description   String?
  sepayId       Int?                    @unique
  sepayReferenceCode String?
  holdReleaseAt DateTime?
  createdAt     DateTime                @default(now())
  wallet        UserWallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("user_wallet_transactions")
}

model UserTopupTransaction {
  id                 String     @id @default(cuid())
  txnCode            String?    @unique
  walletId           String
  amount             Int
  status             String     @default("PENDING")
  transferCode       String
  sepayId            Int?       @unique
  sepayReferenceCode String?
  createdAt          DateTime   @default(now())
  expireAt           DateTime?
  completedAt        DateTime?
  wallet             UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, status])
  @@index([transferCode])
  @@map("user_topup_transactions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      ResetType
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model GuestSession {
  id              String          @id @default(cuid())
  phoneNormalized String
  phoneVerifiedAt DateTime
  expiresAt       DateTime
  deviceId        String?
  lastIp          String?
  isConverted     Boolean         @default(false)
  convertedUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  rescueRequests  RescueRequest[]
  chatbotConversations ChatbotConversation[]

  @@index([phoneNormalized])
  @@index([expiresAt])
  @@map("guest_sessions")
}

model ChatbotConversation {
  id             String              @id @default(cuid())
  userId         String?
  guestSessionId String?
  userRole       ChatbotUserRole
  title          String?
  guidedState    Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       ChatbotMessage[]

  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?       @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guestSessionId])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String              @id @default(cuid())
  conversationId String
  role           ChatbotMessageRole
  content        String
  toolCalls      Json?
  toolResults    Json?
  metadata       Json?
  imageUrls      String[]            @default([])
  createdAt      DateTime            @default(now())

  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chatbot_messages")
}

enum ResetType {
  EMAIL
  PHONE
}

enum RequesterType {
  USER
  GUEST
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  USER
  PROVIDER
  ADMIN
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum ServiceType {
  TOWING
  BATTERY_JUMP
  TIRE_CHANGE
  FUEL_DELIVERY
  LOCKOUT
  BREAKDOWN_REPAIR
}

enum IncidentType {
  BREAKDOWN
  ACCIDENT
  FLAT_TIRE
  BATTERY_DEAD
  OUT_OF_FUEL
  LOCKED_OUT
  OTHER
}

enum RequestStatus {
  CREATED
  SEARCHING
  MATCHED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  ASSIGNED
  MATCHING
  EXPIRED
  ARRIVED
  WORKING
  PAYMENT_PENDING
  PAID
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ProviderType {
  INDIVIDUAL
  BUSINESS
}

enum VerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum UploadPurpose {
  PROVIDER_VERIFICATION
  REQUEST_PHOTO
  REVIEW_PHOTO
  BEFORE_AFTER
  REQUEST_VIDEO
}

enum DocumentType {
  CITIZEN_ID_FRONT
  CITIZEN_ID_BACK
  SELFIE
  MOTORBIKE_PHOTO
  CAR_PHOTO
  DRIVER_LICENSE
  BUSINESS_REGISTRATION
}

enum StorageType {
  R2
  CLOUDINARY
}

enum PaymentMethod {
  CASH
  QR
  WALLET
}

enum PaymentStatus {
  PENDING
  USER_CONFIRMED
  PROVIDER_CONFIRMED
  COMPLETED
  DISPUTED
  REFUNDED
}

enum DisputeCaseStatus {
  WAITING_FOR_PROVIDER
  WAITING_FOR_CUSTOMER
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum DisputeResolutionType {
  FULL_REFUND
  PARTIAL_REFUND
  SPLIT
  NO_REFUND
}

enum DisputeOpenedByRole {
  CUSTOMER
  PROVIDER
}

enum DisputeSenderRole {
  CUSTOMER
  PROVIDER
  ADMIN
  SYSTEM
}

enum DisputeMessageType {
  TEXT
  EVIDENCE
  SYSTEM
}

enum DisputeVisibility {
  PUBLIC
  INTERNAL
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WalletReferenceType {
  JOB
  WITHDRAW
  COMMISSION
  REFUND
  ADJUSTMENT
  TOPUP
  JOB_PAYMENT
}

// Bank codes that appear in the withdrawal account dropdown.
// Users can also enter a custom bank name (bankCode can be null).
enum BankCode {
  VCB
  BIDV
  TCB
  MB
  ACB
  VPB
  CTG
  TPB
  STB
  OCB
  HDB
  VIB
  NAB
  SCB
  BAB
  PGB
  AGR
}

enum UserWalletReferenceType {
  TOPUP
  JOB_PAYMENT
  REFUND
  WITHDRAW
  ADJUSTMENT
}

// ── Platform Configuration ─────────────────────────────────────────────────

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

model FeeAuditLog {
  id          String          @id @default(cuid())
  adminId     String
  adminName   String
  changeType  AuditChangeType
  oldValue    String?
  newValue    String
  note        String?
  createdAt   DateTime        @default(now())

  @@index([createdAt])
  @@map("fee_audit_logs")
}

enum AuditChangeType {
  FEE_RATE
  BANK_ACCOUNT
}

enum ChatbotUserRole {
  USER
  PROVIDER
  GUEST
}

enum ChatbotMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}
