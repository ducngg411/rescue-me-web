// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum cho các loại auth provider
enum AuthProvider {
  EMAIL
  GOOGLE
}

// Enum cho vai trò người dùng
enum UserRole {
  USER      // Người dùng cần cứu hộ
  PROVIDER  // Nhà cung cấp dịch vụ cứu hộ
  ADMIN     // Quản trị viên
}

// Enum cho loại phương tiện
enum VehicleType {
  CAR
  MOTORCYCLE
}

// Enum cho loại dịch vụ cứu hộ
enum ServiceType {
  TOWING           // Kéo xe
  BATTERY_JUMP     // Cứu hộ bình điện
  TIRE_CHANGE      // Thay lốp xe
  FUEL_DELIVERY    // Tiếp nhiên liệu
  LOCKOUT          // Mở khóa xe
  BREAKDOWN_REPAIR // Sửa chữa tại chỗ
}

// Enum cho loại nhà cung cấp
enum ProviderType {
  INDIVIDUAL       // Cá nhân
  BUSINESS         // Doanh nghiệp
}

// Enum cho trạng thái xác minh Provider
enum VerificationStatus {
  DRAFT            // Bản nháp
  PENDING          // Chờ xác minh
  APPROVED         // Đã xác minh
  REJECTED         // Bị từ chối
  SUSPENDED        // Bị tạm ngưng
}

// User Model - Quản lý thông tin người dùng
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  
  // Authentication fields
  authProvider     AuthProvider
  hashedPassword   String?  // Chỉ có giá trị khi authProvider = EMAIL
  googleId         String?  @unique // Chỉ có giá trị khi authProvider = GOOGLE
  
  // Profile & Onboarding
  profileCompleted Boolean  @default(false)
  
  // User Profile (Role = USER)
  fullName         String?
  phoneNumber      String?
  contactEmail     String?
  defaultAddress   Json?   // {addressText, lat, lng}
  vehicleType      VehicleType?
  licensePlate     String?
  vehicleColor     String?
  
  // Provider Profile (Role = PROVIDER)
  providerType            ProviderType?   // Individual hoặc Business
  businessName            String?         // Chỉ dành cho Business
  serviceTypes            ServiceType[]
  supportedVehicleTypes   VehicleType[]
  serviceRadiusKm         Int?            // 5-50 km
  permanentAddress        Json?           // {addressText, lat, lng} - Dành cho Individual
  businessAddress         Json?           // {addressText, lat, lng} - Dành cho Business
  carPlateNumber          String?         // Biển số ô tô
  motorcyclePlateNumber   String?         // Biển số xe máy
  verificationStatus      VerificationStatus  @default(DRAFT)
  isActive                Boolean         @default(false)
  
  // Role & Permissions
  role      UserRole @default(USER)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?
  
  // Relations
  sessions  Session[]
  uploads   Upload[]
  
  @@index([email])
  @@index([googleId])
  @@map("users")
}

// Session Model - Quản lý phiên đăng nhập
model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Enum cho mục đích upload
enum UploadPurpose {
  PROVIDER_VERIFICATION  // Xác minh provider
  REQUEST_PHOTO          // Ảnh yêu cầu cứu hộ
  REVIEW_PHOTO           // Ảnh đánh giá
  BEFORE_AFTER           // Ảnh trước/sau
}

// Enum cho loại tài liệu xác minh
enum DocumentType {
  CITIZEN_ID_FRONT      // CMND/CCCD mặt trước
  CITIZEN_ID_BACK       // CMND/CCCD mặt sau
  SELFIE                // Ảnh selfie
  MOTORBIKE_PHOTO       // Ảnh xe máy
}

// Upload Model - Quản lý file uploads
model Upload {
  id          String        @id @default(cuid())
  userId      String
  
  // Upload metadata
  purpose     UploadPurpose
  docType     DocumentType? // Chỉ dùng cho PROVIDER_VERIFICATION
  
  // File information
  objectKey   String        @unique // providers/{providerId}/verification/{docType}/{timestamp}_{rand}.jpg
  fileName    String
  fileSize    Int           // bytes
  contentType String        // image/jpeg, image/png, image/webp
  
  // URLs
  publicUrl   String
  
  // Status
  confirmed   Boolean       @default(false)
  
  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([purpose])
  @@index([objectKey])
  @@map("uploads")
}
