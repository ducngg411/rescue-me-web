# ────────────────────────────────────────────────────────────────────────────
# Backend Production Environment — copy to .env.production and fill in values
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# ─── Database (DigitalOcean Managed PostgreSQL) ───────────────────────────────
# Get this from: DigitalOcean Dashboard → Databases → your cluster → Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/rescue?schema=public&sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
# IMPORTANT: Must match exactly what you set in Google Cloud Console
GOOGLE_CALLBACK_URL=https://rescueme.asia/api/auth/google/callback

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://rescueme.asia

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ENDPOINT=REPLACE
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET_NAME=rescue-me-uploads
R2_PUBLIC_DOMAIN=REPLACE

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE

# ─── VietMap ──────────────────────────────────────────────────────────────────
VIETMAP_API_KEY=REPLACE

# ─── Sepay ────────────────────────────────────────────────────────────────────
SEPAY_API_KEY=REPLACE
SEPAY_BANK_ACCOUNT=REPLACE
SEPAY_BANK_CODE=REPLACE

# ─── SMTP Gmail ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=REPLACE
MAIL_PASS=REPLACE
MAIL_FROM="RescueMe <REPLACE>"

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=REPLACE
FIREBASE_CLIENT_EMAIL=REPLACE
# Paste the full private key (keep the \n characters)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=REPLACE

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
